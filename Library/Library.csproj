<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>DateTimeRange</AssemblyName>
		<PackageId>DateTimeRanges</PackageId>
		<RepxositoryUrl>https://github.com/resnyanskiy/DateTimeRange</RepxositoryUrl>
		<Description>The library provides a simple DateTimeRange struct and methods for merging, slicing, and finding intersections of time intervals.</Description>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
	</ItemGroup>

</Project>
